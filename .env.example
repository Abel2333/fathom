# ==========================================
# Fathom Deep Research Agent - Environment Variables
# ==========================================
#
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!
#

# ------------------------------------------
# 1. LLM API Configuration (Required)
# ------------------------------------------

# Your LLM API Key (DeepSeek, OpenAI, Anthropic, etc.)
API_KEY=your_api_key_here

# LLM API Base URL
# Examples:
#   - DeepSeek: https://api.deepseek.com
#   - OpenAI: https://api.openai.com/v1
#   - Custom/Proxy: http://your-proxy-url.com/v1
BASE_URL=https://api.deepseek.com

# ------------------------------------------
# 2. Search API Configuration (Required)
# ------------------------------------------

# Tavily Search API Key
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------
# 3. Langfuse Observability (Optional)
# ------------------------------------------

# Langfuse Public Key
# Get your keys at: https://cloud.langfuse.com
# Or from your self-hosted instance
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here

# Langfuse Secret Key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here

# Langfuse Host (Optional)
# Default: https://cloud.langfuse.com
# Use this if you're self-hosting Langfuse
# LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------
# 4. Additional Configuration (Optional)
# ------------------------------------------

# Python Environment
# PYTHONPATH=.

# Logging Level (Optional - overrides config.toml)
# LOG_LEVEL=INFO

# Debug Mode (Optional)
# DEBUG=false

# ------------------------------------------
# Notes:
# ------------------------------------------
#
# 1. LLM Configuration:
#    - API_KEY and BASE_URL are required for the agent to work
#    - Make sure your API key has sufficient credits
#    - The base URL should match your LLM provider
#
# 2. Search Configuration:
#    - TAVILY_API_KEY is required for web searches
#    - Free tier: 1000 searches/month
#    - Sign up at: https://tavily.com
#
# 3. Langfuse Configuration:
#    - Optional but highly recommended for observability
#    - Tracks all LLM calls, costs, and performance
#    - Can be disabled in config.toml if not needed
#    - Free tier available at: https://cloud.langfuse.com
#
# 4. Security:
#    - NEVER commit your .env file to git
#    - Add .env to your .gitignore
#    - Use different keys for development and production
#    - Rotate keys regularly
#
# 5. Getting Started:
#    - Copy this file: cp .env.example .env
#    - Fill in your actual API keys
#    - Run: fathom "Your research query"
#
